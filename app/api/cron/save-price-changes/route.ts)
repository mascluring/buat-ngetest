
import { NextResponse } from 'next/server';
import { getBootstrap } from '@/lib/fpl';
import { createClient } from '@supabase/supabase-js';

export const dynamic = 'force-dynamic';
export const runtime = 'nodejs';

const supabase = createClient(
  process.env.NEXT_PUBLIC_SUPABASE_URL || '',
  process.env.SUPABASE_SERVICE_ROLE_KEY || process.env.NEXT_PUBLIC_SUPABASE_ANON_KEY || ''
);

export async function GET() {
  try {
    const boot = await getBootstrap();
    const elements = boot?.elements || [];
    const teamsMap = new Map<number, any>((boot?.teams || []).map((t: any) => [t.id, t]));

    const todayWib = new Date(new Date().getTime() + 7 * 60 * 60 * 1000);
    const dateStr = todayWib.toISOString().split('T')[0];

    const recordsToInsert: any[] = [];

    elements.forEach((el: any) => {
      const costChange = el.cost_change_event || 0;
      const costChangeFall = el.cost_change_event_fall || 0;

      if (costChange !== 0 || costChangeFall > 0) {
        const team = teamsMap.get(el.team) || {};
        const isRiser = costChange > 0;
        const teamCode = team.code || 1;
        const isGkp = el.element_type === 1;

        const jerseyUrl = isGkp
          ? `https://fantasy.premierleague.com/dist/img/shirts/standard/shirt_${teamCode}_1-66.png`
          : `https://fantasy.premierleague.com/dist/img/shirts/standard/shirt_${teamCode}-66.png`;

        recordsToInsert.push({
          player_id: el.id,
          web_name: el.web_name,
          team_short_name: team.short_name || '',
          change_type: isRiser ? 'Riser' : 'Faller',
          price_change: isRiser ? Number((costChange * 0.1).toFixed(1)) : -Number((Math.abs(costChangeFall || costChange) * 0.1).toFixed(1)),
          now_cost: Number((el.now_cost / 10).toFixed(1)),
          selected_by_percent: el.selected_by_percent || '0.0',
          jersey_url: jerseyUrl,
          change_date: dateStr,
        });
      }
    });

    if (recordsToInsert.length === 0) return NextResponse.json({ ok: true, message: 'Tidak ada perubahan harga hari ini.' });

    const { error } = await supabase.from('price_changes').upsert(recordsToInsert, { onConflict: 'player_id,change_date' });
    if (error) throw new Error(error.message);

    return NextResponse.json({ ok: true, count: recordsToInsert.length, data: recordsToInsert });
  } catch (err: any) {
    return NextResponse.json({ ok: false, error: err?.message }, { status: 500 });
  }
}
